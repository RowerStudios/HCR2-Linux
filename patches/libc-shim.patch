+extern char *__progname;
+static const char *getprognameImpl() { return __progname; }
+
+static void shim_assert2(const char *file, int line, const char *func, const char *failed) {
+    fprintf(stderr, "Assertion failed: %s, file %s, line %d, function %s\n", failed, file, line, func);
+    abort();
+}
+static void shim_android_set_abort_message(const char *msg) { (void)msg; }
+
+static int shim_getentropy(void *buffer, size_t length) {
+    if(!buffer || length > 256)
+        return -1;
+    if(::getrandom(buffer, length, 0) == (ssize_t)length)
+        return 0;
+    return -1;
+}
+static uint32_t shim_arc4random_uniform(uint32_t upper_bound) {
+    if(upper_bound < 2)
+        return 0;
+    uint32_t min = -upper_bound % upper_bound;
+    uint32_t r;
+    do { r = ::arc4random(); } while(r < min);
+    return r % upper_bound;
+}
+static int shim_tgkill(int tgid, int tid, int sig) {
+    return (int)syscall(SYS_tgkill, tgid, tid, sig);
+}
+
 void shim::add_misc_shimmed_symbols(std::vector<shim::shimmed_symbol> &list) {
+    static char **shim_environ = ::environ;
+    static const char *const *shim_progname = &::__progname;
+    static FILE *shim_sF = stdout;
     list.insert(list.end(), {
         {"uname", uname}, // TODO: This may be wrong?
 
+        {"environ", &shim_environ},
+
+        {"__progname", (void *)&::__progname},
+        {"getprogname", (void *)&getprognameImpl},
+        {"__sF", &shim_sF},
+        {"__assert2", (void *)&shim_assert2},
+        {"android_set_abort_message", (void *)&shim_android_set_abort_message},
+        {"getentropy", (void *)&shim_getentropy},
+        {"arc4random_uniform", (void *)&shim_arc4random_uniform},
+        {"usleep", (void *)&::usleep},
+        {"timegm", (void *)&::timegm},
+        {"vsyslog", (void *)&::vsyslog},
+        {"tgkill", (void *)&shim_tgkill},
+        {"pthread_sigmask", (void *)&::pthread_sigmask},
+        {"inotify_init", (void *)&::inotify_init},
+        {"inotify_init1", (void *)&::inotify_init1},
+        {"inotify_add_watch", (void *)&::inotify_add_watch},
+        {"inotify_rm_watch", (void *)&::inotify_rm_watch},
+
         {"utime", utime},
 
         {"writev", writev},
