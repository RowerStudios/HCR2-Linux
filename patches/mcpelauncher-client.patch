new file mode 100644
index 0000000..02258cd
--- /dev/null
+++ b/src/app_config.cpp
@@ -0,0 +1,57 @@
+#include "app_config.h"
+#include <log.h>
+#include <fstream>
+#include <sstream>
+#include <nlohmann/json.hpp>
+
+static AppConfig appConfig;
+static AppConfig* configured = nullptr;
+
+AppConfig& AppConfig::get() {
+    return appConfig;
+}
+
+void AppConfig::loadFromManifest(const ApkInfo& info) {
+    appConfig.package = info.package;
+    appConfig.versionCode = info.versionCode;
+    if(!info.versionName.empty())
+        appConfig.versionName = info.versionName;
+}
+
+void AppConfig::loadFromFile(const std::string& path) {
+    std::ifstream f(path);
+    if(!f.is_open()) {
+        Log::debug("Launcher", "No app config at %s, using defaults", path.c_str());
+        return;
+    }
+    nlohmann::json j;
+    try {
+        j = nlohmann::json::parse(f);
+    } catch(const nlohmann::json::exception& e) {
+        Log::error("Launcher", "Failed to parse app config %s: %s", path.c_str(), e.what());
+        return;
+    }
+
+    if(j.contains("package")) appConfig.package = j.at("package").get<std::string>();
+    if(j.contains("versionName")) appConfig.versionName = j.at("versionName").get<std::string>();
+    if(j.contains("versionCode")) appConfig.versionCode = j.at("versionCode").get<int>();
+    if(j.contains("nativeLibrary")) appConfig.nativeLibrary = j.at("nativeLibrary").get<std::string>();
+    if(j.contains("preloadLibraries")) appConfig.preloadLibraries = j.at("preloadLibraries").get<std::vector<std::string>>();
+    if(j.contains("windowTitle")) appConfig.windowTitle = j.at("windowTitle").get<std::string>();
+    if(j.contains("optionsPath")) appConfig.optionsPath = j.at("optionsPath").get<std::string>();
+    if(j.contains("activityClass")) appConfig.activityClass = j.at("activityClass").get<std::string>();
+    if(j.contains("minecraftPatches")) appConfig.minecraftPatches = j.at("minecraftPatches").get<bool>();
+    if(j.contains("jniMode")) {
+        auto mode = j.at("jniMode").get<std::string>();
+        if(mode == "cocos2dx") {
+            appConfig.jniMode = JniMode::Cocos2dx;
+        } else {
+            appConfig.jniMode = JniMode::Minecraft;
+        }
+    }
+
+    configured = &appConfig;
+    Log::info("Launcher", "App config: package=%s lib=%s mode=%s title=%s",
+              appConfig.package.c_str(), appConfig.nativeLibrary.c_str(),
+              appConfig.jniMode == JniMode::Cocos2dx ? "cocos2dx" : "minecraft", appConfig.windowTitle.c_str());
+}
