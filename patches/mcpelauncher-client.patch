new file mode 100644
index 0000000..758253f
--- /dev/null
+++ b/src/app_config.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <string>
+#include <vector>
+#include <mcpelauncher/apkinfo.h>
+
+// Application mode controlling how the game binary is bootstrapped.
+enum class JniMode {
+    Minecraft,  // com.mojang.minecraftpe native activity (app_glue style)
+    Cocos2dx    // Java-driven Cocos2d-x game (JNI_OnLoad + renderer natives)
+};
+
+// Generic, package-agnostic configuration for which Android app the launcher runs.
+// Defaults to Minecraft; a JSON file in the game directory can override everything.
+struct AppConfig {
+    std::string package = "com.mojang.minecraftpe";
+    std::string versionName;
+    int versionCode = 0;
+
+    // Name of the main native library inside lib/<abi>/ (including the "lib" prefix and ".so" suffix).
+    std::string nativeLibrary = "libminecraftpe";
+    // Additional libraries to preload before the main library (e.g. engine/game plugins).
+    std::vector<std::string> preloadLibraries;
+
+    JniMode jniMode = JniMode::Minecraft;
+
+    std::string windowTitle = "mcpelauncher";
+    // Options file path relative to the primary data directory (-dd).
+    std::string optionsPath = "games/com.mojang/minecraftpe/options.txt";
+    // Whether to apply Minecraft-specific patches (vtables, glcore, xbox, mods, etc.).
+    bool minecraftPatches = true;
+    // FakeJni class name of the main activity (used as the launcher activity).
+    std::string activityClass = "com/mojang/minecraftpe/MainActivity";
+
+    static AppConfig& get();
+    static void loadFromManifest(const ApkInfo& info);
+    // Optional override file inside the game directory (game_dir/app_config.json).
+    static void loadFromFile(const std::string& path);
+};
