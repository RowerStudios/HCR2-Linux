+void MinecraftUtils::setupGLES1Symbols(void* (*resolver)(const char*)) {
+    int i = 0;
+    std::unordered_map<std::string, void*> syms;
+    static const char* gles1_symbols[] = {
+            "glMapBufferOES",
+            "glUnmapBufferOES",
+            "glGetBufferPointervOES",
+            "glBufferData",
+            "glBufferSubData",
+            "glBindBuffer",
+            "glGetIntegerv",
+            "glGetString",
+            "glGetError",
+            "glViewport",
+            "glClear",
+            "glClearColor",
+            nullptr
+    };
+    while(true) {
+        const char* sym = gles1_symbols[i];
+        if(sym == nullptr)
+            break;
+        void* f = resolver(sym);
+        if(f)
+            syms[sym] = f;
+        i++;
+    }
+    linker::load_library("libGLESv1_CM.so", syms);
+}
