+
+// ---- obj_GetInterface ----
+
+// The game may hand GetInterface either a real pointer to the 16-byte uuid, or
+// (observed with baked constants) the raw uuid bytes as a pointer-sized value.
+// Handle both without faulting: if `iid` looks like a readable pointer, memcmp
+// 16 bytes; otherwise compare the 8 raw bytes of the pointer value.
+static bool iidIs(const char *iid, const unsigned char *uuid) {
+    if(!iid) return false;
+    uintptr_t v = (uintptr_t)iid;
+    if(v >= 0x10000 && v < (uintptr_t)0x7fffffffffffULL) {
+        // Plausible readable pointer: whole 16-byte uuid.
+        if(memcmp(iid, uuid, 16) == 0) return true;
+    }
+    const unsigned char b[8] = { (unsigned char)(v), (unsigned char)(v >> 8),
+                                 (unsigned char)(v >> 16), (unsigned char)(v >> 24),
+                                 (unsigned char)(v >> 32), (unsigned char)(v >> 40),
+                                 (unsigned char)(v >> 48), (unsigned char)(v >> 56) };
+    return memcmp(b, uuid, 8) == 0;
+}
+
+SLresult obj_GetInterface(SLObjectItf self, const char *iid, void *pInterface) {
+    {
+        int fd = open("/home/rower/hcr2-ws/opensl.log", O_WRONLY | O_APPEND | O_CREAT, 0644);
+        if(fd >= 0) {
+            char b[256];
+            int n = snprintf(b, sizeof(b), "GetInterface self=%p iid=%p pInterface=%p\n", self, iid, pInterface);
+            if(n > 0) (void)write(fd, b, n);
+            close(fd);
+        }
+    }
+    ObjectImpl *o = objFor(self);
+    if(!o || !pInterface || !iid) return SL_RESULT_PARAMETER_INVALID;
+    if(iidIs(iid, gIID_ENGINE.data) && o->kind == 0) {
+        *(SLEngineItf *)pInterface = (SLEngineItf)&o->engineVf;
+        return SL_RESULT_SUCCESS;
+    }
+    if(o->kind != 2) return SL_RESULT_PRECONDITIONS_VIOLATED;
+    if(iidIs(iid, gIID_PLAY.data)) {
+        *(SLPlayItf *)pInterface = (SLPlayItf)&o->playVf;
+    } else if(iidIs(iid, gIID_VOLUME.data)) {
+        *(SLVolumeItf *)pInterface = (SLVolumeItf)&o->volumeVf;
+    } else if(iidIs(iid, gIID_SEEK.data)) {
+        *(SLSeekItf *)pInterface = (SLSeekItf)&o->seekVf;
+    } else if(iidIs(iid, gIID_PREFETCHSTATUS.data)) {
+        *(SLPrefetchStatusItf *)pInterface = (SLPrefetchStatusItf)&o->prefetchVf;
+    } else if(iidIs(iid, gIID_METADATAEXTRACTION.data)) {
+        *(SLMetadataExtractionItf *)pInterface = (SLMetadataExtractionItf)&o->metaVf;
+    } else if(iidIs(iid, gIID_ANDROIDSIMPLEBUFFERQUEUE.data)) {
+        *(SLAndroidSimpleBufferQueueItf *)pInterface = (SLAndroidSimpleBufferQueueItf)&o->queueVf;
+    } else {
+        return SL_RESULT_PRECONDITIONS_VIOLATED;
+    }
+    return SL_RESULT_SUCCESS;
+}
