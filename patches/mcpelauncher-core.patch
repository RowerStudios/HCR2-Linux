+namespace OpenSL {
+
+// Symbol exports for the fake libOpenSLES.so. Only the subset of OpenSL ES
+// used by Cocos2d-x audio players is implemented; audio is accepted and
+// dropped (no audible output), but initialization succeeds so the game runs.
+std::unordered_map<std::string, void *> getSymbols();
+
